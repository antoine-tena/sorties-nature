##
# Ce fichier montre les variables d'environnement minimales pour lancer le projet.
# On y retrouve le port HTTP expose et tous les parametres utiles pour la base MySQL.
# Il sert surtout de modele quand on veut adapter la configuration localement.
# Les noms choisis correspondent a ce que lit deja le backend PHP et le script Node.
##

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sorties_natures
DB_USER=sorties_user
DB_PASSWORD=sorties_password
